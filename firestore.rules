rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------------------
    // DEFAULT DENY
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // ADMINS COLLECTION
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Firebase Console or Admin SDK
    }

    // -------------------------------------------------------------------------
    // USERS COLLECTION
    // -------------------------------------------------------------------------
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'role', 'status', 'balance', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'name', 'phone', 'email', 'passwordHash', 'role', 'status', 'balance', 'referralCode', 'referredBy', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 100 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.phone is string && data.phone.matches('^\\+258\\d{9}$') &&
             data.role in ['USER', 'ADMIN'] &&
             data.status in ['ACTIVE', 'BLOCKED'] &&
             data.balance is number &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().role == 'USER' && 
                      incoming().balance == 0;
      
      allow update: if (isOwner(userId) || isAdmin()) && 
                      isValidUser(incoming()) && (
                        // Only Admin can change balance or status or role
                        (isAdmin()) || 
                        // User can only change name
                        (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']) && 
                         incoming().balance == existing().balance &&
                         incoming().role == existing().role &&
                         incoming().status == existing().status)
                      );
    }

    // -------------------------------------------------------------------------
    // MATCHES COLLECTION
    // -------------------------------------------------------------------------
    function isValidMatch(data) {
      return data.keys().hasAll(['id', 'competitionName', 'homeTeam', 'awayTeam', 'startTime', 'status', 'createdAt']) &&
             data.id is string &&
             data.status in ['DRAFT', 'OPEN', 'SUSPENDED', 'CLOSED', 'FINISHED', 'CANCELLED'];
    }

    match /matches/{matchId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin() && isValidMatch(incoming());

      match /markets/{marketId} {
        allow read: if true;
        allow write: if isAdmin();

        match /selections/{selectionId} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    // -------------------------------------------------------------------------
    // BETS COLLECTION
    // -------------------------------------------------------------------------
    function isValidBet(data) {
      return data.keys().hasAll(['id', 'userId', 'stake', 'totalOdds', 'potentialReturn', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.stake > 0 &&
             data.status == 'PENDING';
    }

    match /bets/{betId} {
      allow get: if isOwner(existing().userId) || isAdmin();
      allow list: if (isSignedIn() && request.query.limit <= 50 && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidBet(incoming());
      allow update: if isAdmin(); // Only admin can settle bets
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // TRANSACTIONS COLLECTION
    // -------------------------------------------------------------------------
    match /transactions/{transactionId} {
      allow get: if isOwner(existing().userId) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAdmin(); // Transactions are created by system/admin
      allow update, delete: if false; // Transactions are immutable
    }

    // -------------------------------------------------------------------------
    // SETTINGS COLLECTION
    // -------------------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
