# ==============================================================================
# ZONABET - Variáveis de Ambiente (.env.example)
# ==============================================================================

# --- [BACKEND: SERVIDOR EXPRESS] ---
PORT=3000
NODE_ENV=production

# --- [AUTH: SEGURANÇA E SESSÃO JWT] ---
# Chave secreta usada pelo backend para assinar e verificar tokens JWT
JWT_SECRET=substitua_por_uma_chave_secreta_longa_e_segura

# --- [SUPABASE: PERSISTÊNCIA NO BACKEND (LEGACY)] ---
# URL do projeto Supabase (ex: https://xyz.supabase.co)
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave privilegiada usada EXCLUSIVAMENTE pelo backend para operações seguras
SUPABASE_SERVICE_ROLE_KEY=seu_supabase_service_role_secret_key

# --- [FIREBASE: NOVA PERSISTÊNCIA E AUTH] ---
# O conteúdo completo do ficheiro JSON da Service Account do Firebase
# Recomenda-se converter o JSON para uma string compacta ou Base64
FIREBASE_SERVICE_ACCOUNT=seu_firebase_service_account_json_ou_base64
# ID do projeto Firebase
VITE_FIREBASE_PROJECT_ID=careful-yew-464707-b1
# Demais configurações públicas (ver firebase-applet-config.json)
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=careful-yew-464707-b1.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=careful-yew-464707-b1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=...
VITE_FIREBASE_APP_ID=...
VITE_FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-sofalabet-d8b6531a-43f4-40e7-a4de-c32554fc93d3

# --- [FRONTEND: VARIÁVEIS PÚBLICAS VITE] ---
# Variáveis expostas no bundle do cliente navegador (apenas chaves públicas)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=seu_supabase_anon_public_key
# VITE_API_URL: Opcional. Deixe em branco para usar o mesmo host (/api)
VITE_API_URL=

# --- [LIMITES DE APOSTAS (OPCIONAL)] ---
MINIMUM_STAKE=10
MAXIMUM_STAKE=50000
MAXIMUM_POTENTIAL_WIN=1000000
