# Porta do servidor backend (opcional, padrão 3000)
PORT=3000

# Segredo JWT para autenticação (mudar em produção!)
JWT_SECRET=sua_chave_secreta_jwt_aqui

# URL do frontend (usado para CORS e links de redirecionamento)
VITE_API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Ambiente (development | production)
NODE_ENV=development
