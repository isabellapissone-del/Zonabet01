{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public and private profile data for platform users.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "pattern": "^\\+258\\d{9}$" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["USER", "ADMIN"] },
        "status": { "type": "string", "enum": ["ACTIVE", "BLOCKED"] },
        "balance": { "type": "number" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone", "role", "status", "balance", "createdAt", "updatedAt"]
    },
    "Match": {
      "title": "Sport Match",
      "description": "Sports event available for betting.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "competitionId": { "type": "string" },
        "competitionName": { "type": "string" },
        "competitionCategory": { "type": "string" },
        "homeTeam": { "type": "string" },
        "awayTeam": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["DRAFT", "OPEN", "SUSPENDED", "CLOSED", "FINISHED", "CANCELLED"] },
        "homeScore": { "type": "number" },
        "awayScore": { "type": "number" },
        "result": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "competitionName", "homeTeam", "awayTeam", "startTime", "status", "createdAt"]
    },
    "Market": {
      "title": "Betting Market",
      "description": "Specific market (e.g. 1X2) within a match.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "SUSPENDED", "CLOSED", "SETTLED"] }
      },
      "required": ["id", "type", "name", "status"]
    },
    "Selection": {
      "title": "Market Selection",
      "description": "Specific outcome and its odds.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "outcome": { "type": "string" },
        "label": { "type": "string" },
        "odds": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "SETTLED_WIN", "SETTLED_LOST", "VOID"] },
        "result": { "type": "string", "enum": ["WIN", "LOSS", "VOID", "PENDING"] }
      },
      "required": ["id", "outcome", "label", "odds", "status"]
    },
    "Bet": {
      "title": "User Bet",
      "description": "Record of a bet placed by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "type": { "type": "string", "enum": ["SINGLE", "MULTIPLE"] },
        "stake": { "type": "number" },
        "totalOdds": { "type": "number" },
        "potentialReturn": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "WON", "LOST", "VOID", "CANCELLED"] },
        "idempotencyKey": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "stake", "totalOdds", "potentialReturn", "status", "createdAt"]
    },
    "Transaction": {
      "title": "Financial Transaction",
      "description": "Wallet balance change record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["DEPOSIT", "WITHDRAWAL", "BET_PLACEMENT", "BET_WIN", "REFUND", "MANUAL_ADJUSTMENT"] },
        "amount": { "type": "number" },
        "prevBalance": { "type": "number" },
        "nextBalance": { "type": "number" },
        "description": { "type": "string" },
        "adminId": { "type": "string" },
        "referenceId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "amount", "prevBalance", "nextBalance", "createdAt"]
    },
    "SystemSettings": {
      "title": "System Settings",
      "description": "Global platform configurations.",
      "type": "object",
      "properties": {
        "config": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["config", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Matches list."
    },
    "/matches/{matchId}/markets/{marketId}": {
      "schema": "Market",
      "description": "Markets for a match."
    },
    "/matches/{matchId}/markets/{marketId}/selections/{selectionId}": {
      "schema": "Selection",
      "description": "Selections for a market."
    },
    "/bets/{betId}": {
      "schema": "Bet",
      "description": "User bets."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial ledger."
    },
    "/settings/{settingId}": {
      "schema": "SystemSettings",
      "description": "Platform settings."
    }
  }
}
